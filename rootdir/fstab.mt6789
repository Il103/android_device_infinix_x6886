# fstab.mt6789 - Filesystem Table for Infinix Hot 60 Pro Plus (X6886)

/by-name/system        /system        ext4   ro,barrier=1    wait,logical,first_stage_mount,avb
/by-name/vendor        /vendor        ext4   ro,barrier=1    wait,logical,first_stage_mount,avb
/by-name/product       /product       ext4   ro,barrier=1    wait,logical,first_stage_mount,avb
/by-name/cache         /cache         ext4   noatime,nodiratime,nosuid,nodev,noauto_da_alloc,discard    wait,check
/by-name/userdata      /data          f2fs   noatime,nodiratime,nosuid,nodev,discard,sync,inlinecrypt    wait,fileencryption=hardware,quota,reservedsize=128MB,checkpoint=fs
/by-name/misc          /misc          emmc   defaults        defaults
/boot                 /boot          emmc   defaults        defaults
/by-name/metadata      /metadata      ext4   nodev,noatime,nosuid,discard,sync,inlinecrypt    wait,formattable,first_stage_mount,check
/by-name/super         /super         erofs   ro,barrier=1    wait,logical,first_stage_mount,avb
