# init.x6886.rc - Init scripts for Infinix Hot 60 Pro Plus (X6886)

on init
    mkdir /dev/stune 0755 root root
    mkdir /dev/stune/foreground 0755 root root
    mkdir /dev/stune/background 0755 root root
    mkdir /dev/stune/top-app 0755 root root
    mkdir /dev/stune/restricted 0755 root root

    chmod 0664 /sys/class/leds/red/brightness
    chmod 0664 /sys/class/leds/green/brightness
    chmod 0664 /sys/class/leds/blue/brightness
    chmod 0664 /sys/class/leds/lcd-backlight/brightness
    chmod 0664 /sys/class/leds/lcd-backlight/max_brightness

on boot
    write /sys/class/leds/lcd-backlight/max_brightness 2047

    write /sys/devices/system/cpu/cpufreq/policy0/scaling_governor schedutil
    write /sys/devices/system/cpu/cpufreq/policy2/scaling_governor schedutil
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq 500000
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq 2200000
    write /sys/devices/system/cpu/cpufreq/policy2/scaling_min_freq 500000
    write /sys/devices/system/cpu/cpufreq/policy2/scaling_max_freq 2000000

on property:sys.boot_completed=1
    start vendor.camera-provider-2-7
    start android.hardware.health@2.1
    start android.hardware.light@2.0
    start android.hardware.power@2.1
    start android.hardware.sensors@2.1
    start android.hardware.vibrator@1.3
    start android.hardware.thermal@2.0
